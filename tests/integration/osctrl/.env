# Versions and settings for the throwaway osctrl stack used by the osctrl
# integration tests. Pins mirror the upstream osctrl .env.example so the stack
# matches a known-good released combination.
OSCTRL_IMAGE_ORG=jmpsec
OSCTRL_VERSION=0.5.7
NGINX_VERSION=1.31.0-alpine
POSTGRES_VERSION=13.5-alpine
REDIS_VERSION=6.2.6-alpine3.15

# Postgres / osctrl backend credentials. These never leave the throwaway VM.
POSTGRES_DB_NAME=osctrl
POSTGRES_DB_USERNAME=osctrl
POSTGRES_DB_PASSWORD=osctrl
